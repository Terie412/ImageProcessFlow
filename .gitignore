# ============================================================
# ImageProcessFlow — 只保留可复现的源码，忽略依赖 / 产物 / 运行时数据
# ============================================================

# ---------- 私有 / 本地节点（**不进 git**）----------
# 结构与 scripts/ 一模一样：scripts_private/<节点>/manifest.json + .py。
# 里面是只在本机用的东西（内网端点、本机地址、私人参数），所以整目录排除。
# 注册表照样会扫它（见 DESIGN.md §3.23），删掉这行就会把私有的东西带进 git —— 别删。
scripts_private/

# ---------- Python 依赖与虚拟环境 ----------
runtime/venv/
runtime/pip-cache/
venv/
.venv/
env/
*.egg-info/
.eggs/

# ---------- Python 缓存 ----------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Node / 前端依赖与产物 ----------
web/node_modules/
node_modules/
web/dist/
dist/
server/static/
*.tsbuildinfo

# ---------- 运行时临时数据 ----------
runtime/tmp/
**/runtime/npm-cache/
**/runtime/tmp/
temp/
*.log

# ---------- 工作目录（节点画布 + 图片，运行时数据，不进仓库）----------
workspace/
demo/

# ---------- 应用运行时设置（本地偏好，运行时生成）----------
settings.json

# ---------- 测试产生的截图 ----------
runtime/uicheck_*.png

# ---------- 无头 Chrome 的用户数据目录（runtime/shot.js 等会生成，几十 MB）----------
runtime/chrome-profile/
**/chrome-profile/

# ---------- 编辑器 / 系统杂项 ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
