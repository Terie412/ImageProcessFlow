{
  "id": "rounded_box",
  "name": "程序化描边圆角框",
  "entry": "rounded_box.py",
  "inputs": [],
  "params": [
    {
      "key": "width",
      "type": "number",
      "default": 512,
      "min": 16,
      "max": 2048,
      "step": 1,
      "label": "宽"
    },
    {
      "key": "height",
      "type": "number",
      "default": 512,
      "min": 16,
      "max": 2048,
      "step": 1,
      "label": "高"
    },
    {
      "key": "radiusX",
      "type": "number",
      "default": 96,
      "min": 0,
      "max": 1024,
      "step": 1,
      "label": "圆角 X"
    },
    {
      "key": "radiusY",
      "type": "number",
      "default": 96,
      "min": 0,
      "max": 1024,
      "step": 1,
      "label": "圆角 Y"
    },
    {
      "key": "strokeWidth",
      "type": "number",
      "default": 12,
      "min": 0,
      "max": 128,
      "step": 1,
      "label": "描边"
    },
    {
      "key": "fillColor",
      "type": "color",
      "default": "#ffffff",
      "label": "主体色"
    },
    {
      "key": "strokeColor",
      "type": "color",
      "default": "#111111",
      "label": "描边色"
    }
  ],
  "outputs": [
    {
      "key": "image",
      "type": "image",
      "multi": false
    }
  ],
  "preview": {
    "func": "render"
  },
  "_note": "按参数画一张图标：圆角 + 单调色填充 + 一笔描边，透明底 PNG。**没有输入口** —— 它不是处理图，是凭空造图，所以没连任何图也能执行。画布就是「宽 × 高」，描边整个画在框内（外沿贴着图片边缘）。圆角说的是**外圆角**，横轴（圆角 X）、竖轴（圆角 Y）各一个半径：两个相等就是普通圆角，不相等就是**椭圆角**；内圆角自动收成「半径 − 描边」，两个半径各自被它那一条边的一半夹住，任一个填 0 就是直角。",
  "_comment_preview": "preview.func 是脚本模块里那个**纯函数**的名字：服务端实时预览直接 import 这个模块调它（见 server/preview.py），所以节点上的缩略图 / 双击的大图和「执行」产出的图是同一份代码、逐像素一致。带这个段的节点才会显示预览面板，其它节点一行都不受影响。",
  "size": {
    "defaultWidth": 340,
    "defaultHeight": 460
  }
}
